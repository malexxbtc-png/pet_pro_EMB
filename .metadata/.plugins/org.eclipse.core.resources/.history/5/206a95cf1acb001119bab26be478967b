/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "bme280.h"
#include "i2c_slave.h"

/* Private variables ---------------------------------------------------------*/
I2C_HandleTypeDef hi2c1;
I2C_HandleTypeDef hi2c2;
IWDG_HandleTypeDef hiwdg; // Використовуємо IWDG замість WWDG

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
void MX_I2C2_Init(void); // Забрано static для доступу з bme280.c
static void MX_WDG_Init(void);

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();

  /* Configure the system clock */
  SystemClock_Config();

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_I2C2_Init();
  MX_WDG_Init();

  /* USER CODE BEGIN 2 */
  SensorData_t sensor_data;
  uint8_t i2c_retry_count = 0;

  // Ініціалізація датчика BME280/BMP280 на I2C2 з автовідновленням
  while (!BME280_Init(&hi2c2, &sensor_data)) {
      i2c_retry_count++;
      if (i2c_retry_count > 3) {
          I2C2_Bus_Recovery();
          i2c_retry_count = 0;
      }
      HAL_Delay(500);
  }

  // Запуск I2C1 у режимі Slave на адресі 0x30 для зв'язку з Pico
  I2C_Slave_Init(&hi2c1);

  uint32_t last_tick = 0;
  uint8_t heartbeat_counter = 0;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    uint32_t current_tick = HAL_GetTick();
    if (current_tick - last_tick >= 1000) {
        last_tick = current_tick;
        heartbeat_counter++;

        // Читання даних з датчика раз на секунду
        BME280_Read_Data(&hi2c2, &sensor_data);
        if (!sensor_data.sensor_ok) {
            I2C2_Bus_Recovery();
            BME280_Init(&hi2c2, &sensor_data);
        }

        // Оновлення регістрової карти для I2C Slave
        I2C_Slave_Update_Data(&sensor_data, heartbeat_counter);

        // Індикація норми (блимання світлодіодом на PC13)
        HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);

        // Оновлення незалежного сторожового таймера
        HAL_IWDG_Refresh(&hiwdg);
    }
    /* USER CODE END WHILE */
  }
}

