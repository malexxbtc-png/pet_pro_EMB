#include "i2c_slave.h"
#include <string.h>

static uint8_t reg_pointer = 0;
static uint8_t mem_map[32];

uint8_t calculate_crc8(const uint8_t *data, uint8_t len) {
    uint8_t crc = 0x00;
    for (uint8_t i = 0; i < len; i++) {
        crc ^= data[i];
        for (uint8_t j = 0; j < 8; j++) {
            if (crc & 0x80) crc = ((crc << 1) ^ 0x07) & 0xFF;
            else crc = (crc << 1) & 0xFF;
        }
    }
    return crc;
}

void I2C_Slave_Init(I2C_HandleTypeDef *hi2c) {
    memset(mem_map, 0, sizeof(mem_map));
    mem_map[0x00] = 0x53; // WHO_AM_I
    HAL_I2C_EnableListen_IT(hi2c);
}

void I2C_Slave_Update_Data(SensorData_t *sensor, uint8_t hb) {
    __disable_irq();
    mem_map[0x01] = (sensor->sensor_ok & 0x01) | ((sensor->is_bme280 & 0x01) << 1);
    mem_map[0x02] = hb;

    int16_t t = sensor->temperature;
    uint16_t rh = sensor->humidity;
    uint32_t p = sensor->pressure;
    uint16_t td = sensor->dew_point;

    memcpy(&mem_map[0x10], &t, 2);
    memcpy(&mem_map[0x12], &rh, 2);
    memcpy(&mem_map[0x14], &p, 4);
    memcpy(&mem_map[0x18], &td, 2);

    // CRC8 для 10 байт блоку (з 0x10 по 0x19)
    mem_map[0x1A] = calculate_crc8(&mem_map[0x10], 10);
    __enable_irq();
}

// Стабільні колбеки для підтримки Repeated Start від Master (Pico)
void HAL_I2C_AddrCallback(I2C_HandleTypeDef *hi2c, uint8_t TransferDirection, uint16_t AddrMatchCode) {
    if (TransferDirection == I2C_DIRECTION_TRANSMIT) {
        // Master пише адресу регістра
        HAL_I2C_Slave_Sequential_Receive_IT(hi2c, &reg_pointer, 1, I2C_NEXT_FRAME);
    } else {
        // Master читає з поточного reg_pointer (Repeated Start)
        uint8_t len = 1;
        if (reg_pointer >= 0x10 && reg_pointer <= 0x1A) {
            len = 0x1B - reg_pointer;
        } else {
            len = 1;
        }
        HAL_I2C_Slave_Sequential_Transmit_IT(hi2c, &mem_map[reg_pointer], len, I2C_NEXT_FRAME);
    }
}

void HAL_I2C_ListenCpltCallback(I2C_HandleTypeDef *hi2c) {
    HAL_I2C_EnableListen_IT(hi2c);
}

void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c) {
    HAL_I2C_EnableListen_IT(hi2c);
}
