#include "bme280.h"
#include <math.h>

#define BME280_I2C_ADDR (0x76 << 1)

static uint16_t dig_T1;
static int16_t  dig_T2, dig_T3;
static uint16_t dig_P1;
static int16_t  dig_P2, dig_P3, dig_P4, dig_P5, dig_P6, dig_P7, dig_P8, dig_P9;
static uint8_t  dig_H1, dig_H3;
static int16_t  dig_H2, dig_H4, dig_H5;
static int8_t   dig_H6;
static int32_t  t_fine;
static uint8_t  chip_id = 0;

void I2C2_Bus_Recovery(void) {
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOB_CLK_ENABLE();
    // Переводимо PB10 (SCL) у звичайний GPIO Open-Drain для генерації 9 імпульсів
    GPIO_InitStruct.Pin = GPIO_PIN_10;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_OD;
    GPIO_InitStruct.Pull = GPIO_PULLUP;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);

    for (int i = 0; i < 9; i++) {
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10, GPIO_PIN_RESET);
        HAL_Delay(1);
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10, GPIO_PIN_SET);
        HAL_Delay(1);
    }

    // Повертаємо піни у режим I2C
    MX_I2C2_Init();
}

static void read_calibration_data(I2C_HandleTypeDef *hi2c) {
    uint8_t calib24[24];
    HAL_I2C_Mem_Read(hi2c, BME280_I2C_ADDR, 0x88, 1, calib24, 24, 100);
    dig_T1 = (calib24[1] << 8) | calib24[0];
    dig_T2 = (int16_t)((calib24[3] << 8) | calib24[2]);
    dig_T3 = (int16_t)((calib24[5] << 8) | calib24[4]);
    dig_P1 = (calib24[7] << 8) | calib24[6];
    dig_P2 = (int16_t)((calib24[9] << 8) | calib24[8]);
    dig_P3 = (int16_t)((calib24[11] << 8) | calib24[10]);
    dig_P4 = (int16_t)((calib24[13] << 8) | calib24[12]);
    dig_P5 = (int16_t)((calib24[15] << 8) | calib24[14]);
    dig_P6 = (int16_t)((calib24[17] << 8) | calib24[16]);
    dig_P7 = (int16_t)((calib24[19] << 8) | calib24[18]);
    dig_P8 = (int16_t)((calib24[21] << 8) | calib24[20]);
    dig_P9 = (int16_t)((calib24[23] << 8) | calib24[22]);

    if (chip_id == 0x60) {
        HAL_I2C_Mem_Read(hi2c, BME280_I2C_ADDR, 0xA1, 1, &dig_H1, 1, 100);
        uint8_t calib_h[7];
        HAL_I2C_Mem_Read(hi2c, BME280_I2C_ADDR, 0xE1, 1, calib_h, 7, 100);
        dig_H2 = (calib_h[1] << 8) | calib_h[0];
        dig_H3 = calib_h[2];
        dig_H4 = (calib_h[3] << 4) | (calib_h[4] & 0x0F);
        dig_H5 = (calib_h[5] << 4) | (calib_h[4] >> 4);
        dig_H6 = (int8_t)calib_h[6];
    }
}

uint8_t BME280_Init(I2C_HandleTypeDef *hi2c, SensorData_t *data) {
    if (HAL_I2C_Mem_Read(hi2c, BME280_I2C_ADDR, 0xD0, 1, &chip_id, 1, 100) != HAL_OK) {
        data->sensor_ok = 0;
        return 0;
    }
    if (chip_id == 0x60) {
        data->is_bme280 = 1;
    } else if (chip_id == 0x58) {
        data->is_bme280 = 0;
    } else {
        data->sensor_ok = 0;
        return 0;
    }

    read_calibration_data(hi2c);

    uint8_t ctrl_meas = (chip_id == 0x60) ? 0x27 : 0x25;
    uint8_t config = 0xA0;
    if (chip_id == 0x60) {
        uint8_t ctrl_hum = 0x01;
        HAL_I2C_Mem_Write(hi2c, BME280_I2C_ADDR, 0xF2, 1, &ctrl_hum, 1, 100);
    }
    HAL_I2C_Mem_Write(hi2c, BME280_I2C_ADDR, 0xF4, 1, &ctrl_meas, 1, 100);
    HAL_I2C_Mem_Write(hi2c, BME280_I2C_ADDR, 0xF5, 1, &config, 1, 100);

    data->sensor_ok = 1;
    return 1;
}

static int32_t compensate_T(int32_t adc_T) {
    int32_t var1 = ((((adc_T >> 3) - ((int32_t)dig_T1 << 1))) * ((int32_t)dig_T2)) >> 11;
    int32_t var2 = (((((adc_T >> 4) - ((int32_t)dig_T1)) * ((adc_T >> 4) - ((int32_t)dig_T1))) >> 12) * ((int32_t)dig_T3)) >> 14;
    t_fine = var1 + var2;
    return (t_fine * 5 + 128) >> 8;
}

static uint32_t compensate_P(int32_t adc_P) {
    int64_t var1, var2, p;
    var1 = ((int64_t)t_fine) - 128000;
    var2 = var1 * var1 * (int64_t)dig_P6;
    var2 = var2 + ((var1 * (int64_t)dig_P5) << 17);
    var2 = var2 + (((int64_t)dig_P4) << 35);
    var1 = ((var1 * var1 * (int64_t)dig_P3) >> 8) + ((var1 * (int64_t)dig_P2) << 12);
    var1 = (((int64_t)1 << 47) + var1) * ((int64_t)dig_P1) >> 33;
    if (var1 == 0) return 0;
    p = 1048576 - adc_P;
    p = (((p << 31) - var2) * 3125) / var1;
    var1 = (((int64_t)dig_P9) * (p >> 13) * (p >> 13)) >> 25;
    var2 = (((int64_t)dig_P8) * p) >> 19;
    p = ((p + var1 + var2) >> 8) + (((int64_t)dig_P7) << 4);
    return (uint32_t)(p / 256);
}

static uint32_t compensate_H(int32_t adc_H) {
    int32_t v_x1_u32r;
    v_x1_u32r = (t_fine - ((int32_t)76800));
    v_x1_u32r = (((((adc_H << 14) - (((int32_t)dig_H4) << 20) - (((int32_t)dig_H5) * v_x1_u32r)) +
                    ((int32_t)16384)) >> 15) * (((((((v_x1_u32r * ((int32_t)dig_H6)) >> 10) *
                    (((v_x1_u32r * ((int32_t)dig_H3)) >> 11) + ((int32_t)32768))) >> 10) +
                    ((int32_t)2097152)) * ((int32_t)dig_H2) + 8192) >> 14));
    v_x1_u32r = (v_x1_u32r - (((((v_x1_u32r >> 15) * (v_x1_u32r >> 15)) >> 7) * ((int32_t)dig_H1)) >> 4));
    v_x1_u32r = (v_x1_u32r < 0 ? 0 : v_x1_u32r);
    v_x1_u32r = (v_x1_u32r > 419430400 ? 419430400 : v_x1_u32r);
    return (uint32_t)(v_x1_u32r >> 12);
}

void BME280_Read_Data(I2C_HandleTypeDef *hi2c, SensorData_t *data) {
    uint8_t rx_data[8];
    if (HAL_I2C_Mem_Read(hi2c, BME280_I2C_ADDR, 0xF7, 1, rx_data, data->is_bme280 ? 8 : 6, 100) != HAL_OK) {
        data->sensor_ok = 0;
        return;
    }
    int32_t adc_P = ((uint32_t)rx_data[0] << 12) | ((uint32_t)rx_data[1] << 4) | (rx_data[2] >> 4);
    int32_t adc_T = ((uint32_t)rx_data[3] << 12) | ((uint32_t)rx_data[4] << 4) | (rx_data[5] >> 4);

    int32_t temp_raw = compensate_T(adc_T);
    data->temperature = (int16_t)temp_raw;
    data->pressure = compensate_P(adc_P);

    if (data->is_bme280) {
        int32_t adc_H = ((uint32_t)rx_data[6] << 8) | rx_data[7];
        uint32_t hum_raw = compensate_H(adc_H);
        data->humidity = (uint16_t)(hum_raw / 1024);

        float T_c = data->temperature / 100.0f;
        float RH_pct = data->humidity / 100.0f;
        float a = 17.627f;
        float b = 243.12f;
        float gamma = (a * T_c) / (b + T_c) + logf(RH_pct > 0.0f ? RH_pct : 0.001f);
        float td = (b * gamma) / (a - gamma);
        data->dew_point = (int16_t)(td * 100.0f);
    } else {
        data->humidity = 0xFFFF;
        data->dew_point = 0;
    }
    data->sensor_ok = 1;
}
